# Version: 1.1.0
# ── Lightbar Bridge Configuration ─────────────────────────────────
#
# Edit these values, then run:  ./setup.sh
# After setup:                  docker compose up -d
#

# IP address of the Plasma 2350 W on your local network
LIGHTBAR_HOST=192.168.1.100

# HTTP port (must match HTTP_PORT in main.py — default 80)
LIGHTBAR_PORT=80

# Display name in Apple Home / Google Home / Alexa
# Devices will appear as "<NAME> Start" and "<NAME> End"
LIGHTBAR_NAME=Lightbar
