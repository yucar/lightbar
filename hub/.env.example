# Lightbar hub configuration — copy to .env and edit.
# Version: 2.0.0

# ── Versions ─────────────────────────────────────────────────────
# Pin Home Assistant to a release (e.g. 2026.9.3) for predictable upgrades.
HA_VERSION=stable
MOSQUITTO_VERSION=2

TZ=Etc/UTC

# ── MQTT broker ──────────────────────────────────────────────────
# Port the Plasma connects to (config.py → MQTT_PORT).
MQTT_PORT=1883

# Home Assistant's login — enter it when adding the MQTT integration.
MQTT_HA_USER=homeassistant
MQTT_HA_PASSWORD=change-me

# The Lightbar's login — must match MQTT_USER / MQTT_PASSWORD in the
# Plasma's secrets.py. It may only use its own topics.
MQTT_DEVICE_USER=lightbar
MQTT_DEVICE_PASSWORD=change-me

# Must match MQTT_TOPIC_PREFIX in the Plasma's config.py.
MQTT_TOPIC_PREFIX=lightbar

# ── Apple Home (HA's built-in HomeKit Bridge) ────────────────────
HOMEKIT_NAME=Lightbar Bridge
HOMEKIT_PORT=21064
# Which HA entities appear in Apple Home. The default matches
# light.lightbar (all), light.lightbar_start and light.lightbar_end.
HOMEKIT_ENTITY_GLOB=light.lightbar*
